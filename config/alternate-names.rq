PREFIX fx: <http://sparql.xyz/facade-x/ns/>
PREFIX xyz: <http://sparql.xyz/facade-x/data/>

# Map GeoNames' alternateNamesV2 table to language-tagged names. The `alternatenames` column in the
# main table is a comma-separated list carrying no language codes at all, so this table is the only
# source of language information – as GeoNames' own readme puts it, "if you need to know the
# language of a name variant, then you will need to load the table 'alternatenames' and you can drop
# the column in the geoname table". Their RDF service builds names from this table too.
#
# The predicate follows GeoNames' own RDF (https://sws.geonames.org/2921044/about.rdf), except
# that about.rdf discards isColloquial and isHistoric and emits those rows as plain
# gn:alternateName. We keep them, so consumers can avoid promoting an obsolete name such as
# 'West Germany' to a preferred label. All five predicates are in the GeoNames ontology:
# gn:officialName is rdfs:subPropertyOf skos:prefLabel, the other four sit under skos:altLabel.
#
# The flags are not mutually exclusive, so their order below matters. isHistoric and isColloquial
# are tested first, because they are the two that must never reach a preferred label: 2,199 rows
# set one of them together with isPreferredName or isShortName, and 965 of those would otherwise
# become gn:officialName – an obsolete or slang name asserted as a skos:prefLabel. about.rdf has
# the opposite priority, but only because it has no historic or colloquial predicate to lose to.
CONSTRUCT {
    ?uri ?predicate ?label .
}
WHERE {
    SERVICE <x-sparql-anything:> {
        fx:properties
            fx:location "{SOURCE}" ;
            fx:slice true ; # Stream the chunk in row batches instead of loading it whole.
            fx:slice.size "1000" ;
            fx:null-string "" ; # Leaves the language and flag columns unbound when empty.
            fx:csv.delimiter "\t" ;
            fx:csv.headers true ;
            fx:csv.quote-char "false" ; # As in places.rq: the TSV is unquoted but names contain literal '"'.
        .

        ?s xyz:geonameid ?id ;
            xyz:alternate%20name ?name ;
        .

        OPTIONAL { ?s xyz:isolanguage ?language }
        OPTIONAL { ?s xyz:isPreferredName ?isPreferredName }
        OPTIONAL { ?s xyz:isShortName ?isShortName }
        OPTIONAL { ?s xyz:isColloquial ?isColloquial }
        OPTIONAL { ?s xyz:isHistoric ?isHistoric }

        # The isolanguage column doubles as a slot for non-linguistic identifiers: 'wkdt' for the
        # Wikidata ID, 'link' for a URL, plus 'post', 'iata', 'icao', 'nuts', 'unlc' and others that
        # the readme does not enumerate. Since the set is open-ended, allow only plain ISO 639
        # codes rather than blocking known offenders. This also drops language variants such as
        # 'zh-Hant', which about.rdf drops too. See https://github.com/netwerk-digitaal-erfgoed/geonames-rdf/issues/41
        # for publishing the Wikidata IDs.
        # The test is a variable rather than a bare FILTER because a FILTER constrains the whole
        # group and does not gate the BINDs beside it: the group translates to Filter(c, Extend(...)),
        # so STRLANG below is evaluated for every row, including the ones the FILTER then drops
        # (SPARQL 1.1 sections 18.2.4 and 18.5).
        #
        # That would be harmless on its own – section 18.5 leaves the variable unbound when an
        # expression errors – but Jena 6.0.0 raises IllegalFormatConversionException from inside the
        # error path for a bad tag, rather than the ExprEvalException ARQ treats as an expression
        # error, so it escapes and kills the run with no usable message. Jena checks characters
        # only, not the language registry ('1' and 'zz9' are accepted), so of the 45 codes holding a
        # non-alphanumeric character, 'fr_1793' (3,221 rows) is the sole offender: the other 44 are
        # xx-YY variants, and hyphens are allowed.
        BIND(BOUND(?language) && REGEX(?language, "^[a-z]{2,3}$") AS ?isLanguageTag)
        FILTER(!BOUND(?language) || ?isLanguageTag)

        BIND(URI(CONCAT("https://sws.geonames.org/", ?id, "/")) AS ?uri)
        BIND(IF(?isLanguageTag, STRLANG(?name, ?language), ?name) AS ?label)
        BIND(URI(CONCAT("https://www.geonames.org/ontology#",
            IF(BOUND(?isHistoric), "historicalName",
            IF(BOUND(?isColloquial), "colloquialName",
            IF(BOUND(?isPreferredName), "officialName",
            IF(BOUND(?isShortName), "shortName", "alternateName")))))) AS ?predicate)
    }
}
